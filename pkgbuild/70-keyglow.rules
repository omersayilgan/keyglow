# keyglow: let the person at the keyboard drive its RGB controller (ITE 8291,
# 048d:ce00) without root. uaccess grants the active local session access to
# the hidraw node only while that session is in front, the same way logind
# hands out access to sound cards and webcams.
SUBSYSTEM=="hidraw", KERNELS=="0003:048D:CE00.*", TAG+="uaccess"
